# --- Runtime ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000,http://localhost:8080   # comma-separated for several origins

# --- Infrastructure (docker compose up: npm run infra:up) ---
DATABASE_URL=postgres://docmind:docmind@localhost:5432/docmind
REDIS_URL=redis://localhost:6379

# --- Secrets: generate with `openssl rand -hex 32` ---
JWT_SECRET=change-me-to-at-least-32-random-characters
INTERNAL_API_KEY=change-me-long-random-string

# --- Files and AI service ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
AI_SERVICE_URL=http://localhost:8000
